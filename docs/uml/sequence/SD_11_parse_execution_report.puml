@startuml SD_11_Parse_Execution_Report
!theme plain
skinparam handwritten false
skinparam shadowing false
skinparam sequenceArrowThickness 1
skinparam roundcorner 5
skinparam maxMessageSize 120
skinparam sequenceParticipantBorderColor #333333
skinparam sequenceParticipantBackgroundColor #FFFFFF
skinparam sequenceActorBorderColor #333333
skinparam sequenceActorBackgroundColor #FFFFFF
skinparam sequenceLifeLineBorderColor #999999
skinparam defaultFontSize 11
skinparam defaultFontName Arial

title SD-11: View Execution Report — Yetiforce

actor "QA Engineer" as User
boundary "ReportForm" as ReportForm
control "ReportController" as ReportCtrl
entity "ReportEntity" as ReportEntity

User -> ReportForm : selectRun()
User -> ReportForm : submitViewReport()

ReportForm -> ReportCtrl : loadRunDetail(runId)
activate ReportCtrl

ReportCtrl -> ReportEntity : getRunById(runId)
activate ReportEntity
ReportEntity --> ReportCtrl : run
deactivate ReportEntity

ReportCtrl -> ReportEntity : getTestCaseResults(runId)
activate ReportEntity
ReportEntity --> ReportCtrl : testCaseResults[]
deactivate ReportEntity

ReportCtrl -> ReportEntity : getRunLogs(runId)
activate ReportEntity
ReportEntity --> ReportCtrl : logs[]
deactivate ReportEntity

ReportCtrl --> ReportForm : run, testCaseResults[], logs[]
deactivate ReportCtrl

ReportForm --> User : displayExecutionReport()

@enduml
