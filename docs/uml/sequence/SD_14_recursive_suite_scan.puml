@startuml SD_14_Recursive_Suite_Scan
!theme plain
skinparam handwritten false
skinparam shadowing false
skinparam sequenceArrowThickness 1
skinparam roundcorner 5
skinparam maxMessageSize 120
skinparam sequenceParticipantBorderColor #333333
skinparam sequenceParticipantBackgroundColor #FFFFFF
skinparam sequenceActorBorderColor #333333
skinparam sequenceActorBackgroundColor #FFFFFF
skinparam sequenceLifeLineBorderColor #999999
skinparam defaultFontSize 11
skinparam defaultFontName Arial

title SD-14: Scan Test Suite Tree — Yetiforce

actor "QA Engineer" as User
boundary "RunEngineForm" as RunForm
control "SuiteScanController" as ScanCtrl
entity "ProjectEntity" as ProjectEntity

User -> RunForm : selectProject()

RunForm -> ScanCtrl : scanTestSuites(projectId)
activate ScanCtrl

ScanCtrl -> ProjectEntity : getProjectPath(projectId)
activate ProjectEntity
ProjectEntity --> ScanCtrl : projectPath
deactivate ProjectEntity

alt No project path configured
  ScanCtrl --> RunForm : noProjectPathError()
  RunForm --> User : showScanError()
else Project path found
  ScanCtrl -> ProjectEntity : buildSuiteTree(projectPath)
  activate ProjectEntity
  ProjectEntity -> ProjectEntity : locateSuitesFolder()
  loop Traverse directory recursively
    ProjectEntity -> ProjectEntity : readDirectory()
    ProjectEntity -> ProjectEntity : addSuiteNode()
    ProjectEntity -> ProjectEntity : addFolderNode()
  end
  ProjectEntity --> ScanCtrl : tree[], suiteCount
  deactivate ProjectEntity

  ScanCtrl --> RunForm : tree[], suiteCount
  deactivate ScanCtrl
  RunForm --> User : displaySuiteTreePicker()
end

User -> RunForm : selectSuiteNode()
RunForm -> RunForm : setSuitePath()
RunForm --> User : showSuitePathFilled()

@enduml
