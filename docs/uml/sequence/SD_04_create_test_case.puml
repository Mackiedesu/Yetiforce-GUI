@startuml SD_04_Create_Test_Case
!theme plain
skinparam handwritten false
skinparam shadowing false
skinparam sequenceArrowThickness 1
skinparam roundcorner 5
skinparam maxMessageSize 120
skinparam sequenceParticipantBorderColor #333333
skinparam sequenceParticipantBackgroundColor #FFFFFF
skinparam sequenceActorBorderColor #333333
skinparam sequenceActorBackgroundColor #FFFFFF
skinparam sequenceLifeLineBorderColor #999999
skinparam defaultFontSize 11
skinparam defaultFontName Arial

title SD-04: Create Test Case — Yetiforce

actor "QA Engineer" as User
boundary "TestCaseForm" as TCForm
control "TestCaseController" as TCCtrl
entity "TestCaseEntity" as TCEntity

User -> TCForm : fillTestCaseDetails()
User -> TCForm : addSteps()
User -> TCForm : addDataSets()
User -> TCForm : selectSuites()
User -> TCForm : submitSave()

TCForm -> TCForm : validateName()

TCForm -> TCCtrl : createTestCase(projectId, testCaseData)
activate TCCtrl

TCCtrl -> TCCtrl : validatePayload()
TCCtrl -> TCEntity : assertProjectExists(projectId)
activate TCEntity
TCEntity --> TCCtrl : projectFound
deactivate TCEntity

TCCtrl -> TCEntity : save(projectId, testCaseData)
activate TCEntity
TCEntity -> TCEntity : insertTestCase()
TCEntity -> TCEntity : insertSteps()
TCEntity -> TCEntity : insertDataSets()
TCEntity --> TCCtrl : testCase
deactivate TCEntity

alt Suites selected
  loop for each suite
    TCCtrl -> TCEntity : linkToSuite(testCaseId, suiteId)
    activate TCEntity
    TCEntity --> TCCtrl : linked
    deactivate TCEntity
  end
end

TCCtrl --> TCForm : testCase
deactivate TCCtrl

TCForm --> User : showTestCaseCreated()

@enduml
