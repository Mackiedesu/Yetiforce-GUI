@startuml SD_12_Dashboard_View_Report
!theme plain
skinparam handwritten false
skinparam shadowing false
skinparam sequenceArrowThickness 1
skinparam roundcorner 5
skinparam maxMessageSize 120
skinparam sequenceParticipantBorderColor #333333
skinparam sequenceParticipantBackgroundColor #FFFFFF
skinparam sequenceActorBorderColor #333333
skinparam sequenceActorBackgroundColor #FFFFFF
skinparam sequenceLifeLineBorderColor #999999
skinparam defaultFontSize 11
skinparam defaultFontName Arial

title SD-12: Dashboard View Report — Yetiforce

actor "QA Engineer" as User
boundary "DashboardForm" as DashForm
control "DashboardController" as DashCtrl
entity "ExecutionEntity" as ExecEntity

User -> DashForm : openDashboard()

DashForm -> DashCtrl : loadDashboardStats()
activate DashCtrl
DashCtrl -> ExecEntity : getStats()
activate ExecEntity
ExecEntity --> DashCtrl : stats
deactivate ExecEntity
DashCtrl -> ExecEntity : getRecentRuns(limit)
activate ExecEntity
ExecEntity --> DashCtrl : recentRuns[]
deactivate ExecEntity
DashCtrl --> DashForm : stats, recentRuns[]
deactivate DashCtrl

DashForm --> User : displayDashboard()

User -> DashForm : clickViewReport(runId)
DashForm -> DashCtrl : loadRunDetail(runId)
activate DashCtrl
DashCtrl -> ExecEntity : getRunById(runId)
activate ExecEntity
ExecEntity --> DashCtrl : run, logs[], testCaseResults[]
deactivate ExecEntity
DashCtrl --> DashForm : runDetail
deactivate DashCtrl

DashForm --> User : displayRunDetail()

@enduml
